{
  "permissions": {
    "allow": [
      "Edit(wiki/**)",
      "Edit(output/**)",
      "Edit(data/**)",
      "Edit(inbox/**)",
      "Bash(python3 .claude/scripts/fmquery.py *)",
      "Bash(python3 .claude/scripts/selftest.py*)",
      "Bash(python3 .claude/scripts/voice.py *)",
      "Bash(python3 .claude/hooks/validate.py *)",
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git remote remove origin)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(mkdir -p inbox/*)",
      "Bash(mkdir -p wiki/*)",
      "Bash(mkdir -p output/*)",
      "Bash(textutil -convert txt -stdout *)",
      "Bash(date*)",
      "Bash(pwd)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(nc *)",
      "Bash(git push*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(python3 .claude/scripts/..*)",
      "Bash(python3 .claude/hooks/..*)",
      "Edit(.claude/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate.py\""
          }
        ]
      }
    ]
  }
}
