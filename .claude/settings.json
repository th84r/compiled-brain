{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(wiki/**)",
      "Edit(output/**)",
      "Edit(data/**)",
      "Edit(inbox/**)",
      "Bash(python3 .claude/scripts/*)",
      "Bash(python3 .claude/hooks/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(mkdir -p inbox/*)",
      "Bash(mkdir -p wiki/*)",
      "Bash(mkdir -p output/*)",
      "Bash(mv inbox/*)",
      "Bash(ls *)",
      "Bash(textutil -convert txt *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(nc *)",
      "Bash(git push*)",
      "Bash(git remote *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Edit(.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate.py\""
          }
        ]
      }
    ]
  }
}
